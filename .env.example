# ============================================================
#  CVAT 骨格推定モデル 自動デプロイファイル生成 Web アプリ
#  環境変数サンプル。コピーして .env を作成する:
#    cp .env.example .env
#  値は T-02 (app/config.py / pydantic-settings) で読み込む。
# ============================================================

# --- 公開ポート (docker compose がホスト側で公開するポート §3.1 / §11.5) ---
# ブラウザからは http://<実機のIP>:<WEB_PORT> でアクセスする。
# 既定は 8050。8050 が他プロセスと競合する場合のみ、この行を有効化して変更する。
#WEB_PORT=8050

# --- サーバ (コンテナ内部で uvicorn が待受するアドレス。通常は変更不要) ---
APP_HOST=0.0.0.0          # LAN 内からアクセスできるよう 0.0.0.0 で待受 (§3.2)
APP_PORT=8000

# --- ストレージ (web / worker で共有する volume のマウント先 §11.4 / §13) ---
STORAGE_DIR=/storage

# --- Redis (Compose 上のサービス名を既定にする §11.2) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
RQ_QUEUE_NAME=jobs

# --- アップロード上限 (バイト) (§14.3 / §14.4 / §20.4) ---
MAX_SVG_SIZE=5242880       # 5 MB
MAX_PT_SIZE=524288000      # 500 MB

# --- 一時ファイル TTL (秒) (§17.1) ---
TTL_SUCCESS=3600           # 成功ジョブ: 1 時間後に削除
TTL_FAILED=1800            # 失敗ジョブ: 30 分後に削除
CLEANUP_INTERVAL=300       # 掃除処理の実行間隔: 5 分

# --- ONNX 変換の既定値 (ユーザー入力させない固定値 §6 / §14) ---
ONNX_OPSET=12
IMAGE_SIZE=640
# end2end NMS は埋め込まない (false=生出力。model_handler.py 側で NMS を行う)
ONNX_NMS=false

# --- 推論パラメータ既定値 (テンプレートに埋め込む §6) ---
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# --- CVAT serverless 配下への保存 / 自動デプロイ (req_add02 §4/§5/§8) ---
# サーバ内かつ Docker コンテナ外のホスト側 CVAT ルート。
# docker-compose で host==container の同一パスに bind mount する (§5.2)。
# 実際の CVAT リポジトリは ${CVAT_BASE_PATH}/cvat、保存先は
# ${CVAT_BASE_PATH}/cvat/serverless/mymodel/ になる。
# 空のままにすると CVAT 保存 + 自動デプロイをスキップし zip のみ生成する。
CVAT_BASE_PATH=/home/user/projects
# deploy script (deploy_cpu.sh / deploy_gpu.sh) 実行のタイムアウト秒 (§9.6)
DEPLOY_TIMEOUT_SECONDS=600
